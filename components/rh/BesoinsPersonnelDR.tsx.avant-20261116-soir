"use client";
// components/rh/BesoinsPersonnelDR.tsx
// Page Ressources humaines : besoins en personnel exprimés par les directions régionales (situations transmises à la DCCCI),
// mis en regard de l'effectif actuel de chaque centre dans la liste du personnel.
import { useEffect, useMemo, useState } from "react";
import { UserPlus } from "lucide-react";
import { NewFeatureBubble } from "@/components/NewFeatureBubble";
import { situations, type LigneSituation } from "@/lib/situation-dr";
import { cle, type Agent } from "@/lib/rh-effectif";
import s from "./rh.module.css";
import e from "./effectif.module.css";

const CATEGORIE: Record<string, string> = {
  "agent de station": "Agent de station", "agent de zone": "Agent de zone", "plombier": "Plombier",
  "caissière": "Caissier(ère)", "caissier": "Caissier(ère)", "facturier": "Facturier", "chef de centre": "Chef de centre",
};
const dateLongue = (d: string) =>
  new Date(d + "T12:00:00").toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });

export default function BesoinsPersonnelDR({ agents }: { agents: Agent[] }) {
  const [lignes, setLignes] = useState<LigneSituation[] | null>(null);
  useEffect(() => {
    let annule = false;
    fetch("/api/situation-dr", { cache: "no-store", credentials: "include" })
      .then(async (r) => { const j = await r.json(); if (!r.ok || !j.ok) throw new Error(); if (!annule) setLignes(j.lignes as LigneSituation[]); })
      .catch(() => { if (!annule) setLignes([]); }); // pas d'accès à ces données : le bloc n'apparaît pas
    return () => { annule = true; };
  }, []);

  const sits = useMemo(() => (lignes ? situations(lignes).filter((x) => x.besoins.length > 0) : []), [lignes]);
  if (!sits.length) return null;

  const actuel = (centre: string, profil: string): number | null => {
    const cat = CATEGORIE[profil.trim().toLowerCase()];
    if (!cat || !agents.length) return null;
    return agents.filter((a) => a.cf >= "0710" && a.cf.slice(3) !== "0" && cle(a.service) === cle(centre) && a.categorie === cat).length;
  };

  return (
    <NewFeatureBubble id="rh-besoins-personnel-2026-11" block title="Besoins en personnel des directions régionales"
      lines={["Nouveau : les postes demandés par la DR N’Zérékoré, avec l’effectif actuel de chaque centre."]}>
      <section className={`dashboard-card ${s.bloc}`} aria-labelledby="rh-besoins">
        <div className={s.blocEntete}>
          <h3 id="rh-besoins" className={s.blocTitre}><UserPlus size={16} aria-hidden="true" style={{ verticalAlign: -2, marginRight: 8, color: "#38bdf8" }} />Besoins en personnel signalés par les directions régionales</h3>
        </div>
        {sits.map((sit) => {
          const total = sit.besoins.reduce((n, b) => n + b.lignes.reduce((m, x) => m + x.nombre, 0), 0);
          return (
            <div key={sit.dr} style={{ marginBottom: 16 }}>
              <p className={s.note} style={{ marginTop: 0, marginBottom: 10 }}>
                Direction régionale de {sit.dr}, situation du {dateLongue(sit.date)} : <strong>{total} postes demandés</strong> dans {sit.besoins.length} centres
                {sit.centres.length > sit.besoins.length ? ` (les autres centres ne signalent aucun besoin)` : ""}.
              </p>
              <div className={e.tableauScroll}>
                <table className={e.tableau}>
                  <thead>
                    <tr><th scope="col">Centre</th><th scope="col" style={{ textAlign: "left" }}>Profil</th><th scope="col">Demandé</th><th scope="col">Actuellement dans la liste du personnel</th><th scope="col" style={{ textAlign: "left" }}>Observation de la DR</th></tr>
                  </thead>
                  <tbody>
                    {sit.besoins.flatMap((c) => c.lignes.map((l, i) => {
                      const a = actuel(c.centre, l.profil);
                      return (
                        <tr key={c.centre + l.profil}>
                          <td style={{ textAlign: "left" }}>{i === 0 ? <strong>{c.centre}</strong> : ""}</td>
                          <td style={{ textAlign: "left" }}>{l.profil}</td>
                          <td><span className={s.valeur}>{l.nombre}</span></td>
                          <td>{a === null ? "—" : a}</td>
                          <td style={{ textAlign: "left" }}>{l.observation ?? "—"}</td>
                        </tr>
                      );
                    }))}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })}
        <p className={s.pied}>Besoins exprimés tels que transmis ; l’effectif actuel est celui de la liste du personnel par centre de frais.</p>
      </section>
    </NewFeatureBubble>
  );
}
