import { NextResponse } from 'next/server';
import { getCurrentUser, getEffectivePermissions } from '@/lib/auth/auth';
import { getUserById } from '@/lib/users/users';
import { isAvatarUrlSafe } from '@/lib/users/avatar';

// GET /api/auth/me — informations minimales, jamais password_hash/tokens/secrets.
export async function GET() {
  try {
    const user = await getCurrentUser();
    if (!user) return NextResponse.json({ ok: false, error: 'UNAUTHORIZED' }, { status: 401 });

    const full = await getUserById(user.id);
    const permissions = await getEffectivePermissions(user.id, user.role_id, user.role_code);

    return NextResponse.json({
      ok: true,
      data: {
        id: user.id,
        firstName: user.first_name,
        lastName: user.last_name,
        displayName: user.display_name,
        email: user.email,
        role: user.role_code,
        status: user.status,
        department: full?.department_id ?? null,
        agency: full?.agency_name ?? null,
        jobTitle: full?.job_title ?? null,
        phone: full?.phone ?? null,
        avatar: isAvatarUrlSafe(user.avatar) ? user.avatar : null,
        permissions,
      },
    });
  } catch {
    return NextResponse.json({ ok: false, error: 'INTERNAL_SERVER_ERROR' }, { status: 500 });
  }
}