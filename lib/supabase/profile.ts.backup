import { supabaseAdmin } from '@/lib/supabase/admin';

export async function getSupabaseAppUser(authUserId: string) {
  const { data: profile, error } = await supabaseAdmin
    .from('profiles')
    .select('id, legacy_user_id, first_name, last_name, display_name, email, role_id, department_id, agency_id, job_title, phone, avatar, status')
    .eq('id', authUserId)
    .maybeSingle();

  if (error) throw error;

  let roleCode = '';
  let roleName = null;

  if (profile.role_id) {
    const { data: role, error: roleError } = await supabaseAdmin
      .from('roles')
      .select('id, code, name')
      .eq('id', profile.role_id)
      .maybeSingle();

    if (roleError) throw roleError;

    roleCode = role?.code ?? '';
    roleName = role?.name ?? null;
  }

  let agencyName = null;

  if (profile.agency_id) {
    const { data: agency, error: agencyError } = await supabaseAdmin
      .from('agencies')
      .select('id, name')
      .eq('id', profile.agency_id)
      .maybeSingle();

    if (agencyError) throw agencyError;

    agencyName = agency?.name ?? null;
  }

  const permissions = await getSupabaseEffectivePermissions(
    authUserId,
    profile.role_id,
    roleCode
  );

  return {
    id: profile.id,
    legacyUserId: profile.legacy_user_id == null
      ? null
      : Number(profile.legacy_user_id),
    firstName: profile.first_name,
    lastName: profile.last_name,
    displayName: profile.display_name,
    email: profile.email,
    roleId: profile.role_id == null ? null : Number(profile.role_id),
    roleCode,
    roleName,
    status: profile.status,
    departmentId: profile.department_id == null
      ? null
      : Number(profile.department_id),
    agencyId: profile.agency_id == null
      ? null
      : Number(profile.agency_id),
    agencyName,
    jobTitle: profile.job_title,
    phone: profile.phone,
    avatar: profile.avatar,
    permissions,
  };
}

export async function getSupabaseEffectivePermissions(
  authUserId: string,
  roleId: number | null,
  roleCode: string
): Promise<string[]> {
  const { data: allPermissions, error: allError } = await supabaseAdmin
    .from('permissions')
    .select('id, code');

  if (allError) throw allError;

  if (roleCode === 'SUPER_ADMIN') {
    return (allPermissions ?? []).map((p) => p.code);
  }

  const effective = new Set<string>();

  if (roleId) {
    const { data: roleRows, error: roleError } = await supabaseAdmin
      .from('role_permissions')
      .select('permission_id')
      .eq('role_id', roleId);

    if (roleError) throw roleError;

    const ids = (roleRows ?? []).map((r) => r.permission_id);

    for (const permission of allPermissions ?? []) {
      if (ids.includes(permission.id)) {
        effective.add(permission.code);
      }
    }
  }

  const { data: overrides, error: overrideError } = await supabaseAdmin
    .from('user_permissions')
    .select('permission_id, granted')
    .eq('user_id', authUserId);

  if (overrideError) throw overrideError;

  for (const override of overrides ?? []) {
    const permission = (allPermissions ?? []).find(
      (p) => p.id === override.permission_id
    );


    if (override.granted) {
      effective.add(permission.code);
    } else {
      effective.delete(permission.code);
    }
  }

  return Array.from(effective);
}
